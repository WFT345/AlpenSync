<?xml version="1.0" encoding="utf-8"?>
<!--
  Network lockdown (plan Rule 3 + Section 3.6):
  - This file's job is the cleartext ban: no plaintext HTTP anywhere.
  - It does NOT restrict which hosts the app talks to — Android's network
    security config only regulates cleartext and trust anchors per domain
    and CANNOT allowlist destinations (corrected at the 2026-09 audit,
    finding M1; an earlier comment here claimed otherwise). The "requests
    never leave the configured Proton origin" invariant is enforced in
    code: :core:api's HostGuardInterceptor plus followRedirects(false) in
    OkHttpClientFactory, and the HV WebView's WebViewClient confining
    navigation to verify.proton.me.
  - The proton.me entry below is therefore documentation of intent, not
    enforcement — it adds nothing beyond the base-config and exists so the
    cleartext policy stays explicit for the hosts the app actually uses.
    `includeSubdomains="true"` deliberately covers verify.proton.me: the
    human-verification challenge page (Code 9001 flow, ADR 0004 Q3) loads
    in the in-app WebView from that host.
  - Deliberately NO certificate pinning (plan Section 3.6): users and
    auditors must be able to inspect traffic with their own proxy.
    Pinning would undermine the project's verifiability promise.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">proton.me</domain>
    </domain-config>
</network-security-config>
