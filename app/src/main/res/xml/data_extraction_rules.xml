<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup lockdown, part two (2026-09 audit follow-up). allowBackup="false"
  stops cloud backup, but on targetSdk 31+ device-to-device transfer copies
  app data regardless of that flag unless these rules exclude it. The token
  store and contact database must never ride a phone-to-phone migration:
  the durable copy of the address book is Proton, and a fresh sign-in
  restores everything a transfer would have carried.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
