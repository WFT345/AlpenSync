<?xml version="1.0" encoding="utf-8"?>
<!--
  Least privilege (plan Rule 6): every permission below exists for a named
  consumer, and nothing else is requested.
    - INTERNET: the Proton API client (:core:api) cannot function without it.
    - READ_CONTACTS / WRITE_CONTACTS (M2d): the SyncAdapter writes RawContacts
      under our own account type and reads back only what it wrote; granted
      at runtime with an honest rationale on the home screen.
    - GET_ACCOUNTS / AUTHENTICATE_ACCOUNTS / MANAGE_ACCOUNTS are
      deliberately ABSENT (dropped at the 2026-09 audit, finding L3):
      minSdk is 26, and on API 26+ a same-uid authenticator needs none of
      them for its own account type — AUTHENTICATE/MANAGE were removed
      from the platform at API 23. All AccountManager calls here touch
      only our own type (getAccountsByType/addAccountExplicitly).
    - READ/WRITE_SYNC_SETTINGS + READ_SYNC_STATS: marking our account
      syncable and poking requestSync from the WorkManager scheduler.
    - POST_NOTIFICATIONS (API 33+): heads-up when Proton drops the
      session so the user knows to relink. Stays until they sign in again.
    - RECEIVE_BOOT_COMPLETED: restore that notice after a reboot.
  The account/sync services themselves are declared in :module-contacts'
  manifest and merged in.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />

    <uses-permission android:name="android.permission.READ_SYNC_SETTINGS" />
    <uses-permission android:name="android.permission.WRITE_SYNC_SETTINGS" />
    <uses-permission android:name="android.permission.READ_SYNC_STATS" />
    <!-- Tells the user Proton ended the session while the app was closed.
         Asked once at runtime on API 33+; denied still leaves the Relink
         screen on next open. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.AlpenSync">
        <!--
          configChanges: Compose re-lays-out on its own, so the activity must
          NOT be recreated. Recreation dropped the whole login flow — a fresh
          LoginController meant an in-flight 2FA prompt or verification
          challenge lost its stashed credentials and could never complete.
          Handling the change here (rather than saving state) is also the
          Rule 1 answer: an unlocked password must never reach a saved-state
          Bundle, so there is nothing to persist.
        -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|keyboard|navigation|uiMode|density|fontScale|layoutDirection|locale"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <receiver
            android:name=".RelinkBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
